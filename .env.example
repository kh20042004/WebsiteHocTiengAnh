# ============ CLOUDINARY CONFIGURATION ============
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_UPLOAD_FOLDER=english-12-smart

# ============ MONGODB CONFIGURATION ============
# Local MongoDB
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/english_12_smart

# Hoặc MongoDB Atlas (Cloud)
# SPRING_DATA_MONGODB_URI=mongodb+srv://english12_admin:password@cluster.mongodb.net/english_12_smart?retryWrites=true&w=majority

# ============ DATABASE CONFIGURATION (Nếu vẫn dùng MySQL) ============
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/english_12_smart
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=

# ============ JWT CONFIGURATION ============
SECURITY_JWT_SECRET=english12smart_secret_key_very_long_and_secure_change_in_production
SECURITY_JWT_EXPIRATION=86400000
SECURITY_JWT_REFRESH_EXPIRATION=604800000

# ============ GOOGLE CLOUD CONFIGURATION ============
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_CREDENTIALS_PATH=path/to/credentials.json

# ============ REDIS CONFIGURATION ============
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# ============ SERVER CONFIGURATION ============
SERVER_PORT=8080
SPRING_APPLICATION_NAME=english-12-smart

# ============ LOGGING CONFIGURATION ============
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ENGLISH12SMART=DEBUG
